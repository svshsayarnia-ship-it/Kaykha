{
  "version": 2,
  "builds": [
    { "src": "index.js", "use": "@vercel/node" }
  ],
  "routes": [
    {
      "src": "/assets/cities/(.*)",
      "dest": "https://raw.githubusercontent.com/svshsayarnia-ship-it/Kaykha/main/public/assets/cities/$1"
    },
    { "src": "/(.*)", "dest": "/index.js" }
  ]
}
