{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["public/assets/cities/*.webp", "public/assets/characters/*.webp", "public/*.css", "public/*.js", "public/*.webp", "api/*.js"]
      }
    },
    {
      "src": "api/livekit-token.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/livekit-token", "dest": "/api/livekit-token.js" },
    { "src": "/(.*)", "dest": "/index.js" }
  ]
}
